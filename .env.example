# TechOTD Academy — environment variables
# Copy this file to .env.local and fill in real values locally.
# Never commit .env or .env.local.

# SQLite database file path. Relative paths are resolved against the
# project root, and the containing folder (e.g. ./data) is created
# automatically on first run — nothing else to set up by hand.
DATABASE_URL="file:./data/app.db"

# --- Optional ---

# Used to build the canonical/absolute URL in the site's <head> metadata,
# robots.txt and sitemap.xml (see src/app/layout.js, robots.js, sitemap.js).
# Safe to leave unset for local development — it falls back to
# https://academy.techotd.com, which only affects those generated URLs,
# not how the app runs locally.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments (not integrated yet; see src/lib/fees/gateway.js) ---
# Server-side only. Leave unset: no payment gateway is wired up, and the app
# never reports an online payment as successful without verified provider events.
# PAYMENT_PROVIDER=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Notifications (optional; in-app notifications work without any of these) ---
# Email via Resend. All three are required to send email. Server-side only.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="TechOTD Academy <no-reply@your-verified-domain>"
# Enables POST /api/notifications/process for an external scheduler (sent as x-cron-secret).
# CRON_SECRET=""
# WhatsApp is NOT integrated; these are reserved and currently have no effect on sending.
# WHATSAPP_PROVIDER=""
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
