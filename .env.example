# TechOTD Academy — environment variables
# Copy this file to .env.local and fill in real values locally.
# Never commit .env or .env.local.

# PostgreSQL connection string. REQUIRED (there is no default).
#   local:    postgres://user:password@localhost:5432/techotd_dev
#   hosted:   postgres://user:password@host/dbname?sslmode=require
# On Vercel / serverless use your provider's POOLED connection string (Neon: the host
# containing "-pooler"). Percent-encode special characters in the password.
# Use a local or throw-away database for development - never the production one.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/techotd_dev"

# --- Optional ---

# The site's own origin (https://host, no path). Used for canonical URLs,
# robots.txt, sitemap.xml, password-reset emails and certificate links.
# Safe to leave unset for local development — it falls back to
# https://academy.techotd.in, which only affects those generated URLs.
# STAGING / PRODUCTION: required, must be https://, and must be set when you
# BUILD (npm run build) as well as when you run - Next.js bakes NEXT_PUBLIC_*
# in at build time, and a build made with a different value than the running
# environment is refused at startup. See docs/STAGING.md.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments (not integrated yet; see src/lib/fees/gateway.js) ---
# Server-side only. Leave unset: no payment gateway is wired up, and the app
# never reports an online payment as successful without verified provider events.
# PAYMENT_PROVIDER=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Notifications (optional; in-app notifications work without any of these) ---
# Email via Resend. All three are required to send email. Server-side only.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="TechOTD Academy <no-reply@your-verified-domain>"
# Enables POST /api/notifications/process for an external scheduler (sent as x-cron-secret).
# CRON_SECRET=""
# WhatsApp is NOT integrated; these are reserved and currently have no effect on sending.
# WHATSAPP_PROVIDER=""
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# --- AI features (optional; the app works fully without them) ---
# All three are required to enable the learning assistant. Server-side only.
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# AI_MODEL=""            # no default on purpose: set the model you intend to use
# AI_MAX_OUTPUT_TOKENS="600"
# AI_TIMEOUT_MS="20000"

# --- Deployment (Phase 10.10) ---
# Number of reverse proxies YOU operate in front of the app (each appends the
# address it saw to X-Forwarded-For). Rate limiting uses the entry that many
# places from the right; anything further left is client-forged and ignored.
# 1 = one proxy (default). 0 = app exposed directly: forwarding headers are
# ignored and all callers share one bucket (per-account limits still apply).
# TRUSTED_PROXY_HOPS="1"
# Startup validation (src/instrumentation.js) logs warnings for anything missing
# or half-configured (variable NAMES only, never values) and, in production,
# exits non-zero on a dangerous setting (malformed or plain-http site URL,
# a non-SQLite DATABASE_URL).
